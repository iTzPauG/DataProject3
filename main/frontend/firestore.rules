rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /deals/{dealId} {
      allow read: if true;
      allow write: if false;
    }

    // Keep reservations private on client-side; backend admin SDK bypasses rules.
    match /reservations/{reservationId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
